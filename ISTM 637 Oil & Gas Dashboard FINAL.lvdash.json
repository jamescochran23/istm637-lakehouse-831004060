{
  "datasets": [
    {
      "name": "oil_production_daily",
      "displayName": "Oil Production Daily",
      "queryLines": [
        "SELECT\n",
        "  d.calendar_date,\n",
        "  w.basin,\n",
        "  w.operator,\n",
        "  SUM(f.oil_bbl) as total_oil_bbl\n",
        "FROM\n",
        "  istm637_831004060.oilgas.fact_production f\n",
        "    JOIN istm637_831004060.oilgas.dim_date d\n",
        "      ON f.date_id = d.date_id\n",
        "    JOIN istm637_831004060.oilgas.dim_well w\n",
        "      ON f.well_id = w.well_id\n",
        "GROUP BY\n",
        "  d.calendar_date,\n",
        "  w.basin,\n",
        "  w.operator\n",
        "ORDER BY\n",
        "  d.calendar_date"
      ]
    },
    {
      "name": "oil_by_basin",
      "displayName": "Oil Production by Basin",
      "queryLines": [
        "SELECT\n",
        "  w.basin,\n",
        "  w.operator,\n",
        "  SUM(f.oil_bbl) as total_oil_bbl\n",
        "FROM\n",
        "  istm637_831004060.oilgas.fact_production f\n",
        "    JOIN istm637_831004060.oilgas.dim_well w\n",
        "      ON f.well_id = w.well_id\n",
        "GROUP BY\n",
        "  w.basin,\n",
        "  w.operator\n",
        "ORDER BY\n",
        "  total_oil_bbl DESC"
      ]
    },
    {
      "name": "oil_by_quarter",
      "displayName": "Oil Production by Quarter",
      "queryLines": [
        "SELECT\n",
        "  d.quarter_name,\n",
        "  d.year,\n",
        "  d.quarter,\n",
        "  w.basin,\n",
        "  w.operator,\n",
        "  SUM(f.oil_bbl) as total_oil_bbl\n",
        "FROM\n",
        "  istm637_831004060.oilgas.fact_production f\n",
        "    JOIN istm637_831004060.oilgas.dim_date d\n",
        "      ON f.date_id = d.date_id\n",
        "    JOIN istm637_831004060.oilgas.dim_well w\n",
        "      ON f.well_id = w.well_id\n",
        "GROUP BY\n",
        "  d.quarter_name,\n",
        "  d.year,\n",
        "  d.quarter,\n",
        "  w.basin,\n",
        "  w.operator\n",
        "ORDER BY\n",
        "  d.year,\n",
        "  d.quarter"
      ]
    },
    {
      "name": "total_oil_kpi",
      "displayName": "Total Oil Production KPI",
      "queryLines": [
        "SELECT\n",
        "  w.basin,\n",
        "  w.operator,\n",
        "  SUM(f.oil_bbl) as total_oil_bbl\n",
        "FROM\n",
        "  istm637_831004060.oilgas.fact_production f\n",
        "    JOIN istm637_831004060.oilgas.dim_well w\n",
        "      ON f.well_id = w.well_id\n",
        "GROUP BY\n",
        "  w.basin,\n",
        "  w.operator"
      ]
    }
  ],
